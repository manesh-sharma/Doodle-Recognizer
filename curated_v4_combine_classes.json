  "dynamic_support_groups": [
    {
      "target_family": "specific bird prediction",
      "support_class": "bird",
      "specific_classes": [
        "owl",
        "parrot",
        "swan",
        "penguin",
        "flamingo"
      ],
      "combine_rule": "Find the highest-probability specific bird class. Add the probability of the generic bird class to that specific class. Keep the specific bird name as the output.",
      "example": {
        "owl": 0.55,
        "parrot": 0.2,
        "bird": 0.15,
        "other": 0.1,
        "result": "owl",
        "combined_confidence": 0.7
      }
    }
  ],
  "notes": [
    "The bird class is NOT merged into one generic Bird output.",
    "If owl is the highest specific bird prediction, calculate owl + bird.",
    "If parrot is the highest specific bird prediction, calculate parrot + bird.",
    "The same generic-support idea can be extended to other explicitly defined parent/support classes later, but no extra groups are added here."
  ]
